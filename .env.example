# MySQL connection (local instance)
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=changeme
MYSQL_DB=psx_shariah_analyzer

# Telegram (unused until Phase 8, leave blank for now)
TELEGRAM_BOT_TOKEN=

# Scraper hygiene
SCRAPER_USER_AGENT=PSX-Shariah-Analyzer/0.1 (personal research tool)
SCRAPER_REQUEST_DELAY_SECONDS=1.0
SCRAPER_MAX_RETRIES=3
SCRAPER_BACKOFF_FACTOR=2.0
SCRAPER_TIMEOUT_SECONDS=15

# Scheduler
INTRADAY_POLL_INTERVAL_MINUTES=5
MARKET_OPEN_TIME=09:15
MARKET_CLOSE_TIME=15:30
MARKET_TIMEZONE=Asia/Karachi

# App
LOG_LEVEL=INFO
ENV=development
